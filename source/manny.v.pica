; actor shader for Grim Fandango in SCUMMVM

; ORIGINAL GLSL CODE
;	const float CONSTANT_ATTENUATION = 1.0;
;	const float LINEAR_ATTENUATION = 0.0;
;	const float QUADRATIC_ATTENUATION = 1.0;
;
;	in vec3 position;
;	in vec2 texcoord;
;	in vec4 color;
;	in vec3 normal;
;
;	uniform highp mat4 modelMatrix;
;	uniform highp mat4 viewMatrix;
;	uniform highp mat4 projMatrix;
;	uniform highp mat4 extraMatrix;
;	uniform UBOOL textured;
;	uniform UBOOL lightsEnabled;
;	uniform highp vec2 texScale;
;
;	struct shadow_info {
;		UBOOL _active;
;		vec3 _color;
;		vec3 _light;
;		vec3 _point;
;		vec3 _normal;
;	};
;
;	uniform shadow_info shadow;
;
;	out vec2 Texcoord;
;	out vec4 Color;
;
;	void main() {
;		vec4 pos = modelMatrix * extraMatrix * vec4(position, 1.0);
;
;		// See http://en.wikipedia.org/wiki/Line-plane_intersection
;		if (UBOOL_TEST(shadow._active)) {
;			pos /= pos.w;
;			vec3 l = pos.xyz - shadow._light;
;			float d = dot(shadow._point - shadow._light, shadow._normal) / dot(l, shadow._normal);
;			vec3 p = shadow._light + d * l;
;			pos = vec4(p, 1.0);
;		}
;
;		vec4 positionView = viewMatrix * pos;
;		gl_Position = projMatrix * positionView;
;
;		if (UBOOL_TEST(shadow._active)) {
;			Color = vec4(shadow._color, 1.0);
;		} else {
;			Color = color;
;		}
;
;		if (UBOOL_TEST(textured)) {
;			Texcoord = vec2(0.0, 1.0) + (texcoord / texScale);
;		} else {
;			Texcoord = vec2(0.0, 0.0);
;		}
;	}

; NOTES:
;	- "lightsEnabled" is not actually used
;	- Input vector "normal" is passed to the shader as part of the VBO, but isn't used here
;	- Optimize out input vector "color"; it is always (1.0, 1.0, 1.0, 1.0)
;	- Attenuations are not needed in this shader
;	- Shuffle around code to reduce stalling


; Constants
.constf myConst(0.0, 1.0, 2.0, 0.0)
.alias       ZEROS	 myConst.xxxx
.alias        ONES	 myConst.yyyy
.alias    ZERO_ONE	 myConst.xyxy


; Inputs
.alias    inPos		v0		; in vec3 position
.alias inTcoord		v1		; in vec2 texcoord


; Uniforms
.fvec extraMatrix[4]		; mat4 extraMatrix
.fvec modelMatrix[4]		; mat4 modelMatrix
.fvec  viewMatrix[4]		; mat4  viewMatrix
.fvec  projMatrix[4]		; mat4  projMatrix
.fvec    texScale			; vec2    texScale

.ivec calcSphereLoopParams

.fvec shadowLight		;  vec3 shadow._light
.fvec shadowPoint		;  vec3 shadow._point
.fvec shadowNormal		;  vec3 shadow._normal

; Outputs
.out outPos		pos		; gl_Position
.out outTcoord	tcoord0	; out vec2 Texcoord
.out outColor	clr		; out vec4 Color


; Register Aliases
.alias TMP_0			r0
.alias TMP_1			r1
.alias TMP_2			r2
.alias TMP_3			r3
.alias TMP_4			r4
.alias vec4_pos			r5		;  vec4 position
.alias vec4_posView		r6		;  vec4 positionView
.alias vec3_shNo		r6.xyz	;  vec3 shadowNormal, moved to temp register
.alias vec3_shLi		r7.xyz	;  vec3 shadowLight, moved to temp register
.alias vec3_shPo		r8.xyz	;  vec3 shadowPoint, moved to temp register
.alias vec3_shNrm		r6.xyz	;  vec3 shadowNormal, moved to temp register
.alias vec3_shLgt		r7.xyz	;  vec3 shadowLight, moved to temp register
.alias vec3_shPnt		r8.xyz	;  vec3 shadowPoint, moved to temp register
.alias dp3_NrmPnt		r9.x
.alias dp3_NrmLgt		r9.y
.alias dp3_NrmPos		r9.z
.alias dp3_LgtPos		r9.w
.alias vec3_L			r10.xyz	;  vec3 l
.alias flot_D			r10.w	; float d


; Main
.entry main
.proc main
	; TMP_0 = vec4(inPos, 1.0);
	mov TMP_0.xyz,		inPos.xyz
	mov TMP_0.w,		ONES

	; extraVecPos (TMP_2, vec4) = extraMatrix (mat4) * TMP_0 (vec4);
	dp4 TMP_1.x,		extraMatrix[0],		TMP_0
	dp4 TMP_1.y,		extraMatrix[1],		TMP_0
	dp4 TMP_1.z,		extraMatrix[2],		TMP_0
	dp4 TMP_1.w,		extraMatrix[3],		TMP_0

	; TMP_2 = modelMatrix (mat4) * extraVec (vec4);
	dp4 vec4_pos.x,		modelMatrix[0],		TMP_1
	dp4 vec4_pos.y,		modelMatrix[1],		TMP_1
	dp4 vec4_pos.z,		modelMatrix[2],		TMP_1
	dp4 vec4_pos.w,		modelMatrix[3],		TMP_1

;		mov vec3_shLi,		shadowLight.xyz												; vec3_shLi    = shadowLight(xyz)
;		mov vec3_shPo,		shadowPoint.xyz												; vec3_shPo    = shadowPoint(xyz)
;		mov vec3_shNo,		shadowNormal.xyz											; vec3_shNo    = shadowNormal(xyz)
;
;		mad vec3_L,			vec4_pos.w,			-vec3_shLi,			vec4_pos.xyz		; vec3_L       = vec4_pos.xyz - (vec4_pos.w * vec3_shLi)
;		add TMP_0.xyz,		vec3_shPo,			-vec3_shLi								; TMP_0.xyz    = vec3_shPo - vec3_shLi
;		dp3 TMP_2.w,		vec3_L,				 vec3_shNo								; vec4_pos.w   = dot(vec3_L, vec3_shNo)
;		dp3 flot_D,			TMP_0.xyz,			 vec3_shNo								; flot_D       = dot(TMP_0.xyz, vec3_shNo)
;		mul TMP_1.xyz,		TMP_2.w,			 vec3_shLi								; TMP_1.xyz    = vec4_pos.w * vec3_shLi
;		mov vec4_pos.w,		TMP_2.w
;		mad vec4_pos.xyz,	vec3_L,				 flot_D,			TMP_1.xyz			; vec4_pos.xyz = (vec4_pos.xyz - (vec4_pos.w * vec3_shLi)) * (dot(vec3_shPo - vec3_shLi, vec3_shNo)) + (vec4_pos.w * vec3_shLi)

		mov vec3_shNrm,		shadowNormal.xyz									; vec3_shNrm   = shadowNormal(xyz)
		mov vec3_shPnt,		shadowPoint.xyz										; vec3_shPnt   = shadowPoint(xyz)
		mov vec3_shLgt,		shadowLight.xyz										; vec3_shLgt   = shadowLight(xyz)

		dp3 dp3_NrmPnt,		vec3_shNrm,			vec3_shPnt						; dp3(vec3_shNrm, vec3_shPnt)
		dp3 dp3_NrmLgt,		vec3_shNrm,			vec3_shLgt						; dp3(vec3_shNrm, vec3_shLgt)
		dp3 dp3_NrmPos,		vec3_shNrm,			vec4_pos						; dp3(vec3_shNrm, VtxPos.xyz)

		add TMP_0.y,		dp3_NrmPnt,			-dp3_NrmLgt						; dp3_NrmPnt - dp3_NrmLgt
		mad TMP_0.x,		dp3_NrmPnt,			-vec4_pos.w,		dp3_NrmPos	; dp3_NrmPos - (dp3_NrmPnt * VtxPos.w)
		mad TMP_0.z,		dp3_NrmLgt,			-vec4_pos.w,		dp3_NrmPos	; dp3_NrmPos - (dp3_NrmLgt * VtxPos.w)

		mul TMP_1.xyz,		vec3_shLgt,			TMP_0.x							; vec3_shLgt (dp3_NrmPos - (dp3_NrmPnt * VtxPos.w))
		mul TMP_2.xyz,		vec4_pos.xyz,		TMP_0.y							; VtxPos.xyz (dp3_NrmPnt - dp3_NrmLgt)

;		mov vec4_pos.w,		TMP_0.z												; pos.w = dp3_NrmPos - (dp3_NrmLgt * VtxPos.w)
;		add vec4_pos.xyz,	TMP_1.xyz,			TMP_2.xyz						; pos.xyz = vec3_shLgt (dp3_NrmPos - (VtxPos.w * dp3_NrmPnt)) + VtxPos.xyz (dp3_NrmPnt - dp3_NrmLgt)
		rcp TMP_0.w,		TMP_0.z
		add TMP_0.xyz,		TMP_1.xyz,			TMP_2.xyz
		mov vec4_pos.w,		ONES
		mul vec4_pos.xyz,	TMP_0.xyz,			TMP_0.w

;		rcp TMP_0.w,		vec4_pos.w
;		mul vec4_pos,		vec4_pos,			TMP_0.wwww
;
;		dp3 dp3_NrmPnt,		vec3_shNrm,			vec3_shPnt
;		dp3 dp3_NrmLgt,		vec3_shNrm,			vec3_shLgt
;		dp3 dp3_NrmPos,		vec3_shNrm,			vec4_pos.xyz
;
;		add TMP_0.x,		dp3_NrmPnt,			-dp3_NrmLgt
;		add TMP_0.y,		dp3_NrmPos,			-dp3_NrmLgt
;		rcp TMP_0.y,		TMP_0.y
;		mul flot_D,			TMP_0.x,			TMP_0.y
;
;		add TMP_0.x,		ONES,				-flot_D
;
;		mul TMP_1.xyz,		vec4_pos.xyz,		flot_D
;		mov vec4_pos.w,		ONES
;		mad vec4_pos.xyz,	vec3_shLgt,			TMP_0.xxx,			TMP_1.xyz



	; TMP_3 = viewMatrix (mat4) * TMP_2
	dp4 TMP_3.x,		viewMatrix[0],		vec4_pos
	dp4 TMP_3.y,		viewMatrix[1],		vec4_pos
	dp4 TMP_3.z,		viewMatrix[2],		vec4_pos
	dp4 TMP_3.w,		viewMatrix[3],		vec4_pos

	; outPos = projMatrix * positionView;
	; dp4 outPos.x,		projMatrix[0],		TMP_3
	; dp4 outPos.y,		projMatrix[1],		TMP_3
	; dp4 outPos.z,		projMatrix[2],		TMP_3
	; dp4 outPos.w,		projMatrix[3],		TMP_3
	dp4 r4.x,			projMatrix[0],		TMP_3
	dp4 r4.y,			projMatrix[1],		TMP_3
	dp4 r4.z,			projMatrix[2],		TMP_3
	dp4 r4.w,			projMatrix[3],		TMP_3
	rcp r5.w,			r4.w
	mul outPos,			r4,				r5.w

	; outColor = (1.0, 1.0, 1.0, 1.0);
	mov outColor,		ONES

	; outTcoord = vec2(0.0, 1.0) + (inTcoord (vec2) / texScale (vec2));
	rcp r6.x,		texScale.x
	mov r7.xy,		inTcoord.xy
	rcp r6.y,		texScale.y
	mad outTcoord,		r6.xy,			r7.xy,			ZERO_ONE.xy

	end
.end
